{
  "name": "portfolio",
  "version": "4.1.0",
  "private": true,
  "engines": {
    "node": "^26.10.0",
    "npm": "^12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "npm run typecheck && NEXT_DIST_DIR=.next next build --webpack",
    "typecheck": "NEXT_DIST_DIR=.next next typegen && tsc --noEmit",
    "start": "NEXT_DIST_DIR=.next next start",
    "lint": "eslint app components features lib tests",
    "test": "tsx --test tests/contact.test.ts tests/posts.test.ts tests/projects.test.ts tests/security.test.ts tests/services.test.ts tests/seo.test.ts",
    "clean": "rm -rf .next .next-dev"
  },
  "dependencies": {
    "@next/env": "^16.3.8",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "$postcss"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  }
}
